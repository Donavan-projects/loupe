# Copier ce fichier en .env et remplacer les valeurs. Le fichier .env n'est jamais versionné.

# Base Postgres partagée par n8n (schéma public) et Loupe (schéma loupe)
POSTGRES_USER=loupe
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe
POSTGRES_DB=loupe

# Clé de chiffrement des credentials n8n (par exemple : openssl rand -hex 32)
N8N_ENCRYPTION_KEY=remplacer-par-une-cle-aleatoire

# Pour loupe/tests/lancer.py : clé d'API n8n (Paramètres > API) et identifiant du workflow « Loupe — Analyse »
N8N_API_KEY=
LOUPE_WORKFLOW_ID=
